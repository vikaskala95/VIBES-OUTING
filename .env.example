# ─── REQUIRED SECRETS (Change all of these!) ─────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
SESSION_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_STRING
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── RAZORPAY ────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=REPLACE

# ─── EMAIL (SMTP) ───────────────────────────────────────────────
# Gmail setup: Enable 2FA → Google Account → App passwords → Generate for "Mail" & "Windows" → Copy here
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=vibesoutingsupport@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=vibesoutingsupport@gmail.com
SMTP_FROM_NAME=VIBES@Outing

# Alternative: SendGrid SMTP
# Set MAIL_PROVIDER=sendgrid and provide SENDGRID_API_KEY instead of SMTP_USER/SMTP_PASS
SENDGRID_API_KEY=

# ─── APP CONFIG ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
APP_BASE_URL=https://vibesouting.in
ALLOWED_ORIGINS=https://vibesouting.in,https://www.vibesouting.in,https://vibesouting-production.up.railway.app
ALLOWED_ORIGIN_REGEX=
ALLOW_VERCEL_PREVIEWS=false
PASSWORD_RESET_URL=https://vibesouting.in

# ─── DATABASE (PostgreSQL) ───────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/vibes_outing

# ─── API-ONLY MODE (set on Railway backend server) ─────────────
API_ONLY=true
