# ─── REQUIRED SECRETS (Change all of these!) ─────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
SESSION_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_STRING

# ─── RAZORPAY ────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=REPLACE

# ─── EMAIL (SMTP) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── APP CONFIG ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://vibesouting.in,https://www.vibesouting.in,https://vibesouting-production.up.railway.app
PASSWORD_RESET_URL=https://vibesouting.in

# ─── DATABASE ────────────────────────────────────────────────────
DB_PATH=./vibes.db

# ─── API-ONLY MODE (set on Railway backend server) ─────────────
API_ONLY=true
